font-family = "PragmataPro Mono Liga"

# Native desktop/system appearance switching, propagated to apps via Mode 2031.
theme = light:exposed,dark:shady
window-theme = auto

# Preserve exact palette/app colors, matching Kitty (no contrast recoloring).
minimum-contrast = 1
# Keep surfaces opaque and unfocused panes unfaded.
background-opacity = 1
unfocused-split-opacity = 1
