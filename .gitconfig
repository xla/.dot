[alias]
	amend = commit --amend -C HEAD --signoff
	ci    = commit
	co    = checkout
	l     = log --graph --pretty=format':%C(yellow)%h%Cblue%d%Creset %s %C(white) %an, %ar%Creset'
	st    = status -sb
[apply]
	whitespace = warn
[color]
	diff    = auto
	status  = auto
	branch  = auto
	ui      = true
[core]
	editor = nvim
[help]
	autocorrect = 1
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	default = current
[status]
	submodule = 1
[user]
	name        = xla
	email       = self@xla.is
