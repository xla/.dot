// Required Coc extensions:
// :CocInstall coc-json coc-eslint coc-prettier coc-yaml coc-tsserver coc-svelte coc-lua coc-rust-analyzer coc-go coc-snippets
//
// Notes:
// - coc-settings.json supports JSONC comments. :contentReference[oaicite:0]{index=0}
// - coc-eslint deprecates eslint.autoFixOnSave in favor of editor.codeActionsOnSave. :contentReference[oaicite:1]{index=1}
// - coc-rust-analyzer settings are defined by the extension schema, so keep only supported rust-analyzer keys. :contentReference[oaicite:2]{index=2}
{
  // -------------------------------------------------------------------------
  // Formatting
  // -------------------------------------------------------------------------
  // Use per-language format-on-save overrides.
  "[css]": {
    "coc.preferences.formatOnSave": true
  },
  "[go]": {
    "coc.preferences.formatOnSave": true
  },
  "[gomod]": {
    "coc.preferences.formatOnSave": true
  },
  "[html]": {
    "coc.preferences.formatOnSave": true
  },
  "[javascript]": {
    "coc.preferences.formatOnSave": true
  },
  "[json]": {
    "coc.preferences.formatOnSave": true
  },
  "[markdown]": {
    "coc.preferences.formatOnSave": true
  },
  "[rust]": {
    "coc.preferences.formatOnSave": true
  },
  "[svelte]": {
    "coc.preferences.formatOnSave": true
  },
  "[typescript]": {
    "coc.preferences.formatOnSave": true
  },
  "[yaml]": {
    "coc.preferences.formatOnSave": true
  },
  // Prettier should only run when a project config exists.
  "prettier.requireConfig": true,
  // Keep your no-semicolon preference.
  "prettier.semi": false,
  // ESLint fixes on save through code actions.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  // YAML language features.
  "yaml.format.enable": true,
  "yaml.validate": true,
  // -------------------------------------------------------------------------
  // Completion sources
  // -------------------------------------------------------------------------
  // Disable noisy local-word completion sources.
  "coc.source.around.enable": false,
  "coc.source.buffer.enable": false,
  // Keep file path completion.
  "coc.source.file.enable": true,
  // Keep suggestions automatically triggered, but not sluggish.
  "suggest.autoTrigger": "always",
  "suggest.timeout": 500,
  // -------------------------------------------------------------------------
  // Diagnostics
  // -------------------------------------------------------------------------
  // Keep diagnostics enabled.
  "diagnostic.enable": true,
  // Normal editing should focus on warnings and errors only.
  "diagnostic.level": "warning",
  "diagnostic.messageLevel": "warning",
  // Re-check current line, but do not churn while typing.
  "diagnostic.checkCurrentLine": true,
  "diagnostic.refreshOnInsertMode": false,
  // Keep auto float for diagnostic detail.
  "diagnostic.enableMessage": "always",
  "diagnostic.messageTarget": "float",
  "diagnostic.floatConfig": {
    "focusable": false,
    "highlight": "CocFloating"
  },
  // Keep virtual text for warnings/errors across the file.
  // Restrict it to one rendered line per source line.
  "diagnostic.virtualText": true,
  "diagnostic.virtualTextCurrentLineOnly": false,
  "diagnostic.virtualTextLevel": "warning",
  "diagnostic.virtualTextLines": 1,
  "diagnostic.virtualTextPrefix": "",
  "diagnostic.virtualTextLineSeparator": " ",
  // Keep your preferred signs.
  "diagnostic.errorSign": "XX",
  "diagnostic.warningSign": "!!",
  // Keep lower severities quiet in case they surface anywhere.
  "diagnostic.infoSign": ">>",
  "diagnostic.hintSign": "__",
  // -------------------------------------------------------------------------
  // Visual noise reduction
  // -------------------------------------------------------------------------
  // Disable code lens entirely.
  "codeLens.enable": false,

  // -------------------------------------------------------------------------
  // Go
  // -------------------------------------------------------------------------
  "go.goplsPath": "gopls",
  // gopls is installed/updated through Go into ~/.local/bin, not coc-go's
  // private ~/.config/coc/go/bin directory.
  "go.checkForUpdates": "disabled",
  "go.goplsUseDaemon": true,

  "go.goplsOptions": {
    "gofumpt": true,
    "staticcheck": true,
    "usePlaceholders": true,
    "semanticTokens": true,

    "analyses": {
      "unusedparams": true,
      "unusedwrite": true,
      "nilness": true,
      "shadow": true
    },

    "hints": {
      "assignVariableTypes": true,
      "compositeLiteralFields": true,
      "compositeLiteralTypes": true,
      "constantValues": true,
      "functionTypeParameters": true,
      "parameterNames": true,
      "rangeVariableTypes": true
    },

    "codelenses": {
      "generate": true,
      "gc_details": false,
      "regenerate_cgo": true,
      "run_govulncheck": true,
      "tidy": true,
      "upgrade_dependency": true,
      "vendor": true
    }
  },

  "go.tags": {
    "tags": "json",
    "options": "json=omitempty",
    "transform": "snakecase",
    "skipUnexported": true
  },

  // -------------------------------------------------------------------------
  // Rust / rust-analyzer
  // -------------------------------------------------------------------------
  // Use the rustup-managed server installed by setup, rather than downloading
  // another copy into CoC's private data directory.
  "rust-analyzer.server.path": "rust-analyzer",
  // Cargo / macro support.
  "rust-analyzer.cargo.autoreload": true,
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.check.allTargets": true,
  "rust-analyzer.procMacro.enable": true,
  // Keep auto import on completion.
  "rust-analyzer.completion.autoimport.enable": true,
  // Keep diagnostics enabled.
  "rust-analyzer.diagnostics.enable": true,
  // Disable lens-style extras.
  "rust-analyzer.lens.enable": false,
  "rust-analyzer.lens.run.enable": false,
  "rust-analyzer.lens.debug.enable": false,
  // Disable inline hints that shift code.
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.closureReturnTypeHints.enable": "never",
  "rust-analyzer.inlayHints.lifetimeElisionHints.enable": "never",
  "rust-analyzer.inlayHints.renderColons": false,
  "rust-analyzer.inlayHints.maxLength": 25,

  // -------------------------------------------------------------------------
  // Svelte
  // -------------------------------------------------------------------------
  // Keep TypeScript integration inside Svelte.
  "svelte.enable-ts-plugin": true,

  // -------------------------------------------------------------------------
  // System-managed language servers
  // -------------------------------------------------------------------------
  // Keep coc-lua's settings schema, but use Homebrew's LuaLS instead of the
  // extension's private download (which otherwise happens on first activation).
  "lua.enable": false,
  "languageserver": {
    "lua": {
      "command": "lua-language-server",
      "filetypes": ["lua"],
      "rootPatterns": [".luarc.json", ".luarc.jsonc", ".git"],
      "settings": {"Lua": {}}
    },
    "terraform": {
      "command": "terraform-ls",
      "args": [
        "serve"
      ],
      "filetypes": [
        "terraform",
        "tf"
      ],
      "initializationOptions": {},
      "settings": {}
    }
  }
}
